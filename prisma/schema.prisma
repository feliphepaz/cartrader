// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Car {
  id          Int       @id @default(autoincrement())
  name        String
  model       String
  price       Int
  seats       Int
  make        String
  city        String
  miles       Int
  features    String[]
  description String
  image       String
  listerId    String
  messages    Message[]
}

model Message {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  phone       String
  message     String
  listingId   Int
  listing     Car     @relation(fields: [listingId], references: [id])
}
